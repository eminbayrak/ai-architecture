OPENAI_API_KEY=
OPENAI_BASE_URL=
WATCH_VAULT_DIR=
FDE_TIER_FORCE=
FDE_MODEL_INTAKE=
FDE_MODEL_RESEARCH=
FDE_MODEL_EVAL=
FDE_MODEL_DELIVERY=
JIRA_BASE=
# Data Center PAT: ~/.config/atlassian/jira.token or %USERPROFILE%/.config/atlassian/jira.token (chmod 600 / icacls), not in git.
# JIRA_TOKEN=
# JIRA_TOKEN_FILE=
# JIRA_ENV_FILE=
FDE_KB_VAULT=
FDE_KB_VAULT_NAME=
# Optional. Default: ~/.cache/fde-kb/index.sqlite or %LOCALAPPDATA%\fde-kb\index.sqlite.
# FDE_KB_DB=
# Tests/CI: FDE_KB_EMBEDDER=fake (no model load). Uses a separate DB file.
# FDE_KB_EMBEDDER=
# Internal package index for uv (sqlite-vec, model2vec). Public PyPI is not used.
# FDE_KB_UV_INDEX=https://pypi.internal.example/simple
# UV_DEFAULT_INDEX=
# Development only (CI/laptops with a public route): FDE_KB_ALLOW_PUBLIC_INDEX=1
# FDE_KB_ALLOW_PUBLIC_INDEX=
# Model weights are not in git. Lexical FTS5 works without them.
# Optional hybrid: drop the approved potion-base-8M snapshot in
# ~/.cache/fde-kb/models/potion-base-8M or set FDE_KB_MODEL.
# FDE_KB_MODEL=
# FDE_KB_OFFLINE=1 sets HF_HUB_OFFLINE; the skill never downloads weights anyway.
# FDE_KB_OFFLINE=

