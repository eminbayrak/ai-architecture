{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fde-lab.local/fde-kb/golden-case.schema.json",
  "title": "Retrieval golden-set case",
  "type": "object",
  "additionalProperties": true,
  "required": ["query", "path"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "pattern": "^(playbooks|engagements|evals)/.+\\.md$"
    }
  }
}
