{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fde-lab.local/fde-kb/note.schema.json",
  "title": "KB note frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "type", "tags"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["playbook", "engagement", "eval"]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
