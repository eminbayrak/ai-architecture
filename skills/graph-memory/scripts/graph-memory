#!/usr/bin/env bash
# Graph memory CLI. Stdlib only. No package index. No model calls.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${SCRIPT_DIR}/graph_memory.py"

if [ -n "${GRAPH_MEMORY_PYTHON:-}" ]; then
  exec "${GRAPH_MEMORY_PYTHON}" "${PY}" "$@"
fi

if command -v python3 >/dev/null 2>&1; then
  exec python3 "${PY}" "$@"
fi

if command -v python >/dev/null 2>&1; then
  exec python "${PY}" "$@"
fi

echo "graph-memory: need Python 3.12+ on PATH" >&2
exit 1
